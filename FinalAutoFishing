    -- ระบบนับถอยหลังและหน่วงเวลาการเหวี่ยงเบ็ดรอบถัดไป (Cast Delay Cooldown)
    scheduleNextCast = function(customDelay, reason)
        currentScheduleId = (currentScheduleId or 0) + 1
        local thisScheduleId = currentScheduleId

        local delaySec = tonumber(customDelay) or tonumber(Settings.CastDelay) or 2.0
        delaySec = math.max(1.0, delaySec)
        nextAllowedCastTime = os.clock() + delaySec
        ActiveState.Phase = "cooldown"

        task.spawn(function()
            while os.clock() < nextAllowedCastTime do
                if not Settings.AutoFishEnabled or isRestocking or isDepositing or ActiveState.Phase ~= "cooldown" or currentScheduleId ~= thisScheduleId then
                    return
                end
                local remaining = math.max(0, nextAllowedCastTime - os.clock())
                updateUIStatus(string.format("รอเหวี่ยงครั้งถัดไป: %.1f วินาที...", remaining), Theme.Yellow)
                task.wait(0.2)
            end

            if Settings.AutoFishEnabled and not isRestocking and not isDepositing and ActiveState.Phase == "cooldown" and currentScheduleId == thisScheduleId then
                ActiveState.Phase = "idle"
                doCast()
            end
        end)
    end

    -- ฟังก์ชัน doCast ตกปลา
    doCast = function(force)
        if isRestocking or isDepositing then return false end

        -- ป้องกันการเหวี่ยงก่อนครบเวลาหน่วง (Cooldown Guard)
        if not force then
            if os.clock() < nextAllowedCastTime then
                return false
            end
            if ActiveState.Phase == "cast" or ActiveState.Phase == "reel" or ActiveState.Phase == "cooldown" then
                return false
            end
        end

        -- ป้องกันการส่ง request ถี่เกินไป (Debounce 0.8s)
        if isCastingDebounce then return false end
        isCastingDebounce = true
        task.delay(0.8, function()
            isCastingDebounce = false
        end)

        if not FishingRemotes.FishingStart then
            updateUIStatus("ไม่พบ Remote: FishingStart!", Theme.Red)
            return false
        end

        -- 1. ตรวจสอบกระเป๋าเต็มหรือไม่
        if Settings.AutoDeposit and isBackpackFull() then
            if SavedStoragePos and SavedFishingPos then
                task.spawn(performAutoDeposit)
                return false
            else
                updateUIStatus("กระเป๋าเต็ม! แต่ยังไม่ได้บันทึกจุดคลัง/จุดตกปลา", Theme.Red)
                ActiveState.Phase = "idle"
                return false
            end
        end

        -- 2. ตรวจสอบเหยื่อว่าหมดหรือไม่
        if not hasBaitAvailable() then
            if Settings.AutoRestock then
                if SavedStoragePos and SavedFishingPos then
                    task.spawn(performAutoRestock)
                    return false
                else
                    updateUIStatus("เหยื่อหมด! แต่ยังไม่ได้บันทึกจุดคลัง/จุดตกปลา", Theme.Red)
                    ActiveState.Phase = "idle"
                    return false
                end
            else
                updateUIStatus("รอเหยื่อ... / เหยื่อหมด (Auto Restock ปิดอยู่)", Theme.Red)
                ActiveState.Phase = "idle"
                return false
            end
        end

        local rodSlot  = getTargetRodSlot()
        local baitSlot = getTargetBaitSlot()
        local targetPos = getCastTargetPoint()

        equipRodIfNeeded(rodSlot)

        ActiveState.Phase = "cast"
        ActiveState.CastTime = os.clock()
        ActiveState.IsReeling = false

        updateUIStatus("กำลังเหวี่ยงเบ็ด... (Casting)", Theme.Yellow)
        FishingRemotes.FishingStart:FireServer(rodSlot, baitSlot, targetPos)
        return true
    end

    local function handleReelPhase(state)
        ActiveState.Phase      = "reel"
        ActiveState.CastId     = state.castId
        ActiveState.BiteAt     = state.biteAt or Workspace:GetServerTimeNow()
        ActiveState.Speed      = state.speed or 1
        ActiveState.ZoneCenter = state.zoneCenter or 0.5
        ActiveState.ZoneWidth  = state.zoneWidth or 0.25
        ActiveState.Deadline   = state.deadline or (ActiveState.BiteAt + 5)
        ActiveState.IsReeling  = false

        updateUIStatus("ปลากินแล้ว! กำลังตวัดเบ็ด...", Theme.Green)

        task.spawn(function()
            while ActiveState.Phase == "reel" and not ActiveState.IsReeling do
                local now = Workspace:GetServerTimeNow()
                if (ActiveState.Deadline - now) <= 0.2 then
                    doReel()
                    break
                end

                local curPos = markerAt(now, ActiveState.BiteAt, ActiveState.Speed)
                local diff = math.abs(curPos - ActiveState.ZoneCenter)

                if diff <= (ActiveState.ZoneWidth * 0.45) then
                    doReel()
                    break
                end

                RunService.Heartbeat:Wait()
            end
        end)
    end

    if FishingRemotes.FishingState then
        FishingRemotes.FishingState.OnClientEvent:Connect(function(state)
            if typeof(state) ~= "table" or not state.phase then return end

            if state.phase == "cast" then
                ActiveState.CastId = state.castId
                ActiveState.Phase  = "cast"
                updateUIStatus("เหวี่ยงเบ็ดแล้ว... รอปลากิน (Waiting for bite)", Theme.Yellow)

            elseif state.phase == "reel" then
                handleReelPhase(state)

            elseif state.phase == "result" then
                ActiveState.Phase = "result"
                ActiveState.IsReeling = false

                if state.ok then
                    Stats.Catches = Stats.Catches + 1
                    local itemName = "ปลา"
                    if state.rewards and #state.rewards > 0 then
                        local r = state.rewards[1]
                        itemName = string.format("%s ×%d", tostring(r.name or r.itemId or "ปลา"), tonumber(r.qty) or 1)
                    elseif state.name then
                        itemName = string.format("%s ×%d", tostring(state.name or state.itemId or "ปลา"), tonumber(state.qty) or 1)
                    end
                    Stats.LastCatch = itemName
                    updateUIStatus("✓ ตกสำเร็จ! ได้: " .. itemName, Theme.Green)
                else
                    Stats.Misses = Stats.Misses + 1
                    local reason = tostring(state.message or "ปลาหลุด")
                    updateUIStatus("✗ พลาด: " .. reason, Theme.Red)
                end

                fetchBaitCounts()
                if updateBackpackUI then updateBackpackUI() end

                -- ตรวจสอบกระเป๋าเต็มทันทีหลังตกปลา
                if Settings.AutoDeposit and (isBackpackFull() or (not state.ok and state.message and (string.find(string.lower(tostring(state.message)), "เต็ม") or string.find(string.lower(tostring(state.message)), "กระเป๋า") or string.find(string.lower(tostring(state.message)), "น้ำหนัก") or string.find(string.lower(tostring(state.message)), "weight") or string.find(string.lower(tostring(state.message)), "full")))) then
                    if SavedStoragePos and SavedFishingPos then
                        ActiveState.Phase = "idle"
                        task.spawn(performAutoDeposit)
                        return
                    else
                        updateUIStatus("กระเป๋าเต็ม! แต่ยังไม่ได้บันทึกจุดคลัง/จุดตกปลา", Theme.Red)
                    end
                end

                -- ตรวจสอบเหยื่อหมดทันทีหลังตกปลา
                if not hasBaitAvailable() then
                    if Settings.AutoRestock and SavedStoragePos and SavedFishingPos then
                        ActiveState.Phase = "idle"
                        task.spawn(performAutoRestock)
                        return
                    else
                        updateUIStatus("เหยื่อหมด! (รอเติมเหยื่อ)", Theme.Red)
                        ActiveState.Phase = "idle"
                        return
                    end
                end

                if Settings.AutoFishEnabled and not isRestocking and not isDepositing then
                    scheduleNextCast(Settings.CastDelay, "result")
                else
                    ActiveState.Phase = "idle"
                end

            elseif state.phase == "cancel" then
                ActiveState.CastId = nil
                ActiveState.IsReeling = false
                updateUIStatus("รอบตกปลาถูกยกเลิก", Theme.TextMuted)

                if Settings.AutoFishEnabled and not isRestocking and not isDepositing then
                    scheduleNextCast(Settings.CastDelay, "cancel")
                else
                    ActiveState.Phase = "idle"
                end
            end
        end)
    end

    -- Loop ควบคุมการทำงานอัตโนมัติ (Supervisor Loop)
    task.spawn(function()
        while true do
            task.wait(1)
            if Settings.AutoFishEnabled and not isRestocking and not isDepositing then
                -- 1. ถ้ากระเป๋าเต็ม ให้เริ่มขั้นตอนเดินไปเก็บของเข้าคลังทันที
                if Settings.AutoDeposit and isBackpackFull() then
                    if SavedStoragePos and SavedFishingPos then
                        currentScheduleId = (currentScheduleId or 0) + 1
                        doCancel()
                        ActiveState.Phase = "idle"
                        task.spawn(performAutoDeposit)
                    else
                        updateUIStatus("กระเป๋าเต็ม! (กรุณาบันทึกจุดคลังและเปิด Auto Deposit)", Theme.Red)
                    end
                -- 2. ถ้าเหยื่อหมด ให้เริ่มขั้นตอนเดินไปเบิกเหยื่อทันที
                elseif not hasBaitAvailable() then
                    if Settings.AutoRestock and SavedStoragePos and SavedFishingPos then
                        currentScheduleId = (currentScheduleId or 0) + 1
                        doCancel()
                        ActiveState.Phase = "idle"
                        task.spawn(performAutoRestock)
                    else
                        updateUIStatus("เหยื่อหมด! (กรุณาบันทึกจุดคลังและเปิด Auto Restock)", Theme.Red)
                    end
                -- 3. ถ้าอยู่ในสถานะ cooldown (กำลังนับถอยหลังรอเหวี่ยง) ห้ามแทรกแซงเด็ดขาด ปล่อยให้ scheduleNextCast ทำงาน
                elseif ActiveState.Phase == "cooldown" then
                    -- Cooldown active, do nothing
                -- 4. ถ้าเหวี่ยงเบ็ดค้างนานเกิน 25 วินาที (เซิร์ฟเวอร์ค้างหรือปลาไม่กิน)
                elseif ActiveState.Phase == "cast" then
                    if (os.clock() - ActiveState.CastTime) > 25 then
                        updateUIStatus("ระบบตรวจสอบ: รอปลานานเกินไป กำลังเหวี่ยงใหม่...", Theme.Yellow)
                        doCancel()
                        task.wait(1.5)
                        if Settings.AutoFishEnabled and not isRestocking and not isDepositing then
                            scheduleNextCast(2.0, "stuck_cast")
                        end
                    end
                -- 5. ถ้าอยู่ในสถานะ idle นานเกินไป และหมดเวลารอแล้ว ให้เหวี่ยงเบ็ดต่อ
                elseif ActiveState.Phase == "idle" then
                    if os.clock() >= nextAllowedCastTime then
                        task.wait(1)
                        if Settings.AutoFishEnabled and not isRestocking and not isDepositing and ActiveState.Phase == "idle" and os.clock() >= nextAllowedCastTime then
                            doCast()
                        end
                    end
                -- 6. ถ้าค้างอยู่ที่สถานะ result นานเกิน 12 วินาที (ป้องกันหลุดสถานะ)
                elseif ActiveState.Phase == "result" then
                    if os.clock() >= nextAllowedCastTime then
                        task.wait(1)
                        if Settings.AutoFishEnabled and not isRestocking and not isDepositing and ActiveState.Phase == "result" then
                            ActiveState.Phase = "idle"
                            doCast()
                        end
                    end
                end
            end
        end
    end)

    local function setAutoFishing(enabled)
        Settings.AutoFishEnabled = enabled
        if enabled then
            currentScheduleId = (currentScheduleId or 0) + 1
            nextAllowedCastTime = 0
            MainToggleBtn.Text = "🎣  เปิดตกปลา AUTO : เปิดใช้งาน (ON)"
            MainToggleBtn.BackgroundColor3 = Theme.Green
            MainToggleStroke.Color = Theme.Green
            updateUIStatus("เริ่มระบบตกปลาอัตโนมัติ...", Theme.Green)
            doCast(true)
        else
            currentScheduleId = (currentScheduleId or 0) + 1
            MainToggleBtn.Text = "🎣  เปิดตกปลา AUTO : ปิด (OFF)"
            MainToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
            MainToggleStroke.Color = Theme.Border
            doCancel()
            disableNoclip()
            ActiveState.Phase = "idle"
            updateUIStatus("ปิดระบบตกปลาแล้ว (Idle)", Theme.TextMuted)
        end
    end

    MainToggleBtn.MouseButton1Click:Connect(function()
        setAutoFishing(not Settings.AutoFishEnabled)
    end)

    ScanBtn.MouseButton1Click:Connect(function()
        scanInventory()
        updateUIStatus(string.format("สแกนเสร็จ: พบเบ็ด %d ชิ้น, เหยื่อ %d ชิ้น", #DetectedRods, #DetectedBaits), Theme.Green)
    end)

    CastNowBtn.MouseButton1Click:Connect(function()
        currentScheduleId = (currentScheduleId or 0) + 1
        nextAllowedCastTime = 0
        ActiveState.Phase = "idle"
        doCast(true)
    end)

    CancelBtn.MouseButton1Click:Connect(function()
        currentScheduleId = (currentScheduleId or 0) + 1
        doCancel()
        disableNoclip()
        ActiveState.Phase = "idle"
        nextAllowedCastTime = os.clock() + 1.5
    end)

    local dragging = false
    local dragInput, dragStart, startPos

    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainWindow.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    Header.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            MainWindow.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    local function toggleMinimize()
        isMinimized = not isMinimized
        if isMinimized then
            Tween(MainWindow, {Size = UDim2.new(0, 390, 0, 48)}, 0.2)
            Body.Visible = false
            MinBtn.Text = "+"
        else
            Body.Visible = true
            Tween(MainWindow, {Size = UDim2.new(0, 390, 0, 520)}, 0.2)
            MinBtn.Text = "-"
        end
    end

    MinBtn.MouseButton1Click:Connect(toggleMinimize)
    CloseBtn.MouseButton1Click:Connect(function()
        ScreenGui.Enabled = false
    end)

    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.X then
            if not ScreenGui.Enabled then
                ScreenGui.Enabled = true
            else
                toggleMinimize()
            end
        end
    end)

    LocalPlayer.CharacterAdded:Connect(function()
        disableNoclip()
        isDepositing = false
        isRestocking = false
        unfreezePlayer()
    end)

    _G.UniqueFishingCleanup = function()
        Settings.AutoFishEnabled = false
        disableNoclip()
        doCancel()
        pcall(function()
            if ScreenGui then ScreenGui:Destroy() end
        end)
        print("[Unique HUB] ล้างระบบ Auto Fishing เรียบร้อย")
    end

    scanInventory()
    updateUIStatus("พร้อมใช้งาน (กด X ย่อ/ขยาย UI)", Theme.Green)
end

