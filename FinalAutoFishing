-- ══════════════════ KEY & HWID LOCK VERIFICATION ENGINE ══════════════════
local function verifyAndLockKeyOnline(inputKey)
    inputKey = string.gsub(inputKey or "", "^%s*(.-)%s*$", "%1")
    if inputKey == "" then
        return false, "กรุณากรอกคีย์ก่อนกดยืนยัน"
    end

    local myHwid = getHWID()
    local fileContent = ""
    local fileSha = nil

    -- 1. พยายามดึงผ่าน GitHub REST API ถ้ามี GITHUB_TOKEN (เพื่อให้ได้ SHA สำหรับเขียนทับ)
    local hasToken = (typeof(GITHUB_TOKEN) == "string" and GITHUB_TOKEN ~= "")
    local req = (syn and syn.request) or request or http_request or (http and http.request)

    if hasToken and req then
        local apiUrl = string.format("https://api.github.com/repos/%s/%s/contents/%s", GITHUB_OWNER, GITHUB_REPO, GITHUB_PATH)
        local ok, resp = pcall(function()
            return req({
                Url = apiUrl,
                Method = "GET",
                Headers = {
                    ["Authorization"] = "Bearer " .. GITHUB_TOKEN,
                    ["Accept"] = "application/vnd.github.v3+json",
                    ["User-Agent"] = "UniqueHub-KeySystem"
                }
            })
        end)
        if ok and resp and resp.Body then
            local jsonOk, data = pcall(function() return HttpService:JSONDecode(resp.Body) end)
            if jsonOk and data and data.sha and data.content then
                fileSha = data.sha
                fileContent = base64Decode(data.content)
            end
        end
    end

    -- 2. ถ้าไม่ได้ใช้ Token หรือดึง API ไม่สำเร็จ ให้ดึงผ่าน Raw URL (พร้อม timestamp กันแคช)
    if fileContent == "" then
        local rawUrl = GITHUB_KEYS_URL .. "?t=" .. tostring(os.time())
        fileContent = fetchUrl(rawUrl) or fetchUrl(GITHUB_KEYS_URL) or ""
    end

    if fileContent == "" then
        return false, "ไม่สามารถเชื่อมต่อ GitHub ได้ กรุณาตรวจสอบอินเทอร์เน็ต"
    end

    -- 3. แยกบรรทัดและวิเคราะห์คีย์
    local lines = {}
    local keyFound = false
    local keyNeedsBind = false
    local targetLineIndex = -1

    for line in string.gmatch(fileContent, "[^\r\n]+") do
        table.insert(lines, line)
    end

    for idx, line in ipairs(lines) do
        local trimmed = string.gsub(line, "^%s*(.-)%s*$", "%1")
        if trimmed ~= "" and not string.find(trimmed, "^#") and not string.find(trimmed, "^%-%-") then
            local colonIdx = string.find(trimmed, ":")
            if colonIdx then
                -- คีย์นี้ถูกผูก HWID ไว้แล้วบน GitHub (KEY:HWID)
                local k = string.gsub(string.sub(trimmed, 1, colonIdx - 1), "^%s*(.-)%s*$", "%1")
                local h = string.gsub(string.sub(trimmed, colonIdx + 1), "^%s*(.-)%s*$", "%1")
                if k == inputKey then
                    keyFound = true
                    if h == myHwid then
                        -- HWID ตรงกับเครื่องนี้ 100%!
                        saveKeyLocal(inputKey, myHwid)
                        return true, "คีย์ถูกต้อง! ยินดีต้อนรับเข้าสู่ระบบ"
                    else
                        -- มีเครื่องอื่นผูกคีย์นี้ไปแล้ว และ HWID ไม่ตรง! บล็อกทันที
                        return false, "คีย์นี้ถูกใช้งานและล็อคกับเครื่องอื่นไปแล้ว! (HWID Locked)"
                    end
                end
            else
                -- คีย์ยังไม่ได้ผูก HWID (เป็นคีย์ว่าง)
                if trimmed == inputKey then
                    keyFound = true
                    keyNeedsBind = true
                    targetLineIndex = idx
                end
            end
        end
    end

    if not keyFound then
        return false, "คีย์ไม่ถูกต้อง หรือไม่มีอยู่ในระบบ"
    end

    -- 4. จัดการคีย์ที่ยังไม่ได้ผูก HWID (Unbound Key)
    if keyNeedsBind then
        if STRICT_HWID_ONLY and not hasToken then
            return false, "คีย์นี้ยังไม่ได้รับการผูกกับเครื่องของคุณ กรุณาส่ง HWID ให้แอดมินเปิดใช้งาน"
        end

        -- ถ้ามี GITHUB_TOKEN: อัปเดตผูก HWID ขึ้น GitHub ทันทีแบบ Real-Time!
        if hasToken and fileSha and req then
            lines[targetLineIndex] = inputKey .. ":" .. myHwid
            local newContent = table.concat(lines, "\n")
            local newBase64 = base64Encode(newContent)

            local putUrl = string.format("https://api.github.com/repos/%s/%s/contents/%s", GITHUB_OWNER, GITHUB_REPO, GITHUB_PATH)
            local putOk, putResp = pcall(function()
                return req({
                    Url = putUrl,
                    Method = "PUT",
                    Headers = {
                        ["Authorization"] = "Bearer " .. GITHUB_TOKEN,
                        ["Accept"] = "application/vnd.github.v3+json",
                        ["User-Agent"] = "UniqueHub-KeySystem",
                        ["Content-Type"] = "application/json"
                    },
                    Body = HttpService:JSONEncode({
                        message = "Lock key " .. inputKey .. " to HWID " .. myHwid,
                        content = newBase64,
                        sha = fileSha
                    })
                })
            end)

            if putOk and putResp and (putResp.StatusCode == 200 or putResp.StatusCode == 201) then
                saveKeyLocal(inputKey, myHwid)
                return true, "คีย์ถูกต้อง! และได้บันทึกล็อคเครื่องขึ้น GitHub เรียบร้อยแล้ว"
            else
                warn("[Unique HUB] เกิดข้อผิดพลาดในการ Commit ขึ้น GitHub:", putResp and putResp.Body)
            end
        end

        -- กรณีไม่มี Token ให้ผูกกับ Local Storage และแจ้งเตือน
        saveKeyLocal(inputKey, myHwid)
        return true, "คีย์ถูกต้อง! (ใส่ GITHUB_TOKEN เพื่อให้ล็อคขึ้น GitHub อัตโนมัติ)"
    end

    return false, "เกิดข้อผิดพลาดในการตรวจสอบคีย์"
end

