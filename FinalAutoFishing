    local function findWarehouseBait(searchName)
        local prof = getLatestProfile()
        if prof and prof.Warehouse then
            local s = string.lower(tostring(searchName or ""))
            -- 1. ตรวจสอบตรงกับที่ผู้เล่นระบุ
            for _, item in ipairs(prof.Warehouse) do
                if typeof(item) == "table" and item.InvId and item.ItemId then
                    local qty = tonumber(item.Qty) or 1
                    if qty > 0 then
                        local lowerId = string.lower(item.ItemId)
                        local shopItem = Config and Config.ShopItem and Config.ShopItem(item.ItemId)
                        local itemName = (shopItem and shopItem.Name) or item.ItemId
                        local lowerName = string.lower(itemName)

                        if s == "chubby" or s == "baitchubby" or string.find(s, "chubby") then
                            if lowerId == "baitchubby" or string.find(lowerId, "chubby") or string.find(lowerName, "chubby") then
                                return item
                            end
                        elseif s == "spider" or s == "baitspider" or string.find(s, "แมงมุม") or string.find(s, "ใยทมิฬ") then
                            if lowerId == "baitspider" or string.find(lowerId, "spider") or string.find(lowerName, "ใยทมิฬ") or string.find(lowerName, "spider") then
                                return item
                            end
                        elseif s ~= "" and (string.find(lowerName, s, 1, true) or string.find(lowerId, s, 1, true)) then
                            return item
                        end
                    end
                end
            end
            -- 2. ถ้าไม่พบ ให้หาเหยื่อชิ้นใดก็ได้ในคลัง
            for _, item in ipairs(prof.Warehouse) do
                if typeof(item) == "table" and item.InvId and item.ItemId then
                    local qty = tonumber(item.Qty) or 1
                    if qty > 0 then
                        local lowerId = string.lower(item.ItemId)
                        if string.find(lowerId, "bait") or lowerId == "baitchubby" or lowerId == "baitspider" then
                            return item
                        end
                    end
                end
            end
        end
        return nil
    end

    local function findBestBackpackSlotForBait(baitItemId)
        local prof = getLatestProfile()
        if prof and prof.Backpack and prof.Backpack.Slots then
            -- ถ้ามีช่องที่มีเหยื่อชนิดนี้อยู่แล้ว ให้เบิกลงช่องเดิมเพื่อ stack
            for slotIdx, slotData in pairs(prof.Backpack.Slots) do
                if typeof(slotData) == "table" and slotData.ItemId == baitItemId then
                    return tonumber(slotIdx) or 4
                end
            end
            -- ถ้าไม่มี ให้หาช่องว่างช่องแรก (ช่อง 4 ถึง 30)
            for s = 4, 30 do
                local slotData = prof.Backpack.Slots[s]
                if not slotData or slotData.ItemId == nil or slotData.ItemId == "" then
                    return s
                end
            end
        end
        return 4
    end

