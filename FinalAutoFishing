local function getLatestProfile()
    -- 1. ตรวจสอบจาก cachedProfile
    if cachedProfile and (cachedProfile.Warehouse or cachedProfile.Backpack) then
        return cachedProfile
    end

    -- 2. ดึงผ่าน debug.getupvalues จาก Client.world.Fishing (เชื่อมตรงกับ u161.profile ของตัวเกม)
    pcall(function()
        local getupv = debug.getupvalues or getupvalues
        if getupv then
            local pScripts = LocalPlayer:FindFirstChild("PlayerScripts")
            local clientMod = pScripts and pScripts:FindFirstChild("Client")
            local fishingScript = clientMod and clientMod:FindFirstChild("world") and clientMod.world:FindFirstChild("Fishing")
            if fishingScript then
                local fishingMod = require(fishingScript)
                local targets = {fishingMod.Build, fishingMod.Press, fishingMod.Cancel, fishingMod.IsActive}
                for _, fn in ipairs(targets) do
                    if typeof(fn) == "function" then
                        for _, upv in pairs(getupv(fn)) do
                            if typeof(upv) == "function" then
                                local ok, res = pcall(upv)
                                if ok and typeof(res) == "table" then
                                    if res.profile and (res.profile.Warehouse or res.profile.Backpack) then
                                        cachedProfile = res.profile
                                        return
                                    elseif res.Warehouse and res.Backpack then
                                        cachedProfile = res
                                        return
                                    end
                                end
                            elseif typeof(upv) == "table" then
                                if upv.profile and (upv.profile.Warehouse or upv.profile.Backpack) then
                                    cachedProfile = upv.profile
                                    return
                                elseif upv.Warehouse and upv.Backpack then
                                    cachedProfile = upv
                                    return
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
    if cachedProfile and (cachedProfile.Warehouse or cachedProfile.Backpack) then
        return cachedProfile
    end

    -- 3. ตรวจสอบผ่าน getgc(true)
    if getgc then
        local ok, res = pcall(function()
            for _, v in ipairs(getgc(true)) do
                if typeof(v) == "table" then
                    local prof = rawget(v, "profile")
                    if typeof(prof) == "table" and (rawget(prof, "Warehouse") or rawget(prof, "Backpack")) then
                        return prof
                    end
                    if rawget(v, "Warehouse") and rawget(v, "Backpack") then
                        return v
                    end
                end
            end
        end)
        if ok and res then
            cachedProfile = res
            return res
        end
    end

    -- 4. ตรวจสอบผ่าน debug.getregistry() / getreg()
    pcall(function()
        local getreg_fn = debug.getregistry or getreg
        if getreg_fn then
            for _, v in pairs(getreg_fn()) do
                if typeof(v) == "table" then
                    local prof = rawget(v, "profile")
                    if typeof(prof) == "table" and (rawget(prof, "Warehouse") or rawget(prof, "Backpack")) then
                        cachedProfile = prof
                        return
                    end
                    if rawget(v, "Warehouse") and rawget(v, "Backpack") then
                        cachedProfile = v
                        return
                    end
                end
            end
        end
    end)

    return cachedProfile
end

