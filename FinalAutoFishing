    local function getBackpackInfo()
        local prof = getLatestProfile()
        local weight = 0
        local weightMax = 120
        local bagSize = 20
        local usedSlots = 0
        local totalBagSlots = 20
        local bagStart = (Inventory and Inventory.BAG_START) or 7

        if prof and prof.Backpack then
            local bp = prof.Backpack
            weight = tonumber(bp.Weight) or 0
            weightMax = tonumber(bp.WeightMax) or (Inventory and Inventory.DEFAULT_WEIGHT) or 120
            bagSize = tonumber(bp.Size) or (Inventory and Inventory.DEFAULT_SIZE) or 26
            totalBagSlots = math.max(1, bagSize - bagStart + 1)

            if bp.Slots then
                for i = bagStart, bagSize do
                    local slot = bp.Slots[i]
                    local isSlotEmpty = true
                    if Inventory and Inventory.IsEmpty then
                        isSlotEmpty = Inventory.IsEmpty(slot)
                    else
                        if slot and typeof(slot) == "table" and slot.ItemId and slot.ItemId ~= "" and (tonumber(slot.Qty) or 1) > 0 then
                            isSlotEmpty = false
                        end
                    end
                    if not isSlotEmpty then
                        usedSlots = usedSlots + 1
                    end
                end
            end
        end

        -- สำรอง: อ่านจาก UI ของตัวเกมหาก profile ยังไม่อัพเดท
        if weight == 0 and weightMax <= 120 then
            pcall(function()
                local pg = LocalPlayer:FindFirstChild("PlayerGui")
                local csgo = pg and pg:FindFirstChild("CSGO_UI")
                if csgo then
                    local weightLab = csgo:FindFirstChild("Weight", true)
                    if weightLab and weightLab:IsA("TextLabel") and weightLab.Text ~= "" then
                        local curW, maxW = string.match(weightLab.Text, "([%d%.]+)%s*/%s*([%d%.]+)")
                        if curW and maxW then
                            weight = tonumber(curW) or weight
                            weightMax = tonumber(maxW) or weightMax
                        end
                    end
                end
            end)
        end

        local weightRatio = (weightMax > 0) and (weight / weightMax) or 0
        local freeSlots = math.max(0, totalBagSlots - usedSlots)
        return {
            Weight = weight,
            WeightMax = weightMax,
            WeightRatio = weightRatio,
            UsedSlots = usedSlots,
            TotalSlots = totalBagSlots,
            FreeSlots = freeSlots,
        }
    end

    local function isBackpackFull()
        local info = getBackpackInfo()
        -- 1. เช็คน้ำหนัก: ถ้าน้ำหนักเกิน 98% หรือเหลือไม่ถึง 1.0 KG
        if info.WeightMax > 0 then
            if info.Weight >= (info.WeightMax - 1.0) or info.WeightRatio >= 0.98 then
                return true, string.format("น้ำหนักเต็ม (%.1f/%.0f KG)", info.Weight, info.WeightMax)
            end
        end
        -- 2. เช็คจำนวนช่อง: ถ้าช่องว่างเหลือ 0 ช่อง
        if info.TotalSlots > 0 and info.FreeSlots <= 0 then
            return true, string.format("ช่องกระเป๋าเต็ม (%d/%d ช่อง)", info.UsedSlots, info.TotalSlots)
        end
        return false, nil
    end

