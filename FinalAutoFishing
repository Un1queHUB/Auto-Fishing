    local function fetchBaitCounts()
        local cCount = 0
        local sCount = 0
        local cWh = 0
        local sWh = 0

        -- วิธีที่ 1: ตรวจนับจาก Profile (ทั้งกระเป๋า Backpack และคลัง Warehouse)
        pcall(function()
            local prof = getLatestProfile()
            if prof then
                if prof.Backpack and prof.Backpack.Slots then
                    for _, slot in pairs(prof.Backpack.Slots) do
                        if typeof(slot) == "table" and slot.ItemId then
                            local q = math.max(0, math.floor(tonumber(slot.Qty) or 1))
                            local id = tostring(slot.ItemId)
                            local idLower = string.lower(id)
                            if id == "BaitChubby" or string.find(idLower, "chubby") then
                                cCount = cCount + q
                            elseif id == "BaitSpider" or string.find(idLower, "spider") or string.find(idLower, "ใยทมิฬ") then
                                sCount = sCount + q
                            end
                        end
                    end
                end
                if prof.Warehouse then
                    for _, item in ipairs(prof.Warehouse) do
                        if typeof(item) == "table" and item.ItemId then
                            local q = math.max(0, math.floor(tonumber(item.Qty) or 1))
                            local id = tostring(item.ItemId)
                            local idLower = string.lower(id)
                            if id == "BaitChubby" or string.find(idLower, "chubby") then
                                cWh = cWh + q
                            elseif id == "BaitSpider" or string.find(idLower, "spider") or string.find(idLower, "ใยทมิฬ") then
                                sWh = sWh + q
                            end
                        end
                    end
                end
            end
        end)

        -- วิธีที่ 2: สำรองตรวจนับจากหน้าจอ UI (SlotCards และ BagHud) เผื่อ Profile ยังไม่โหลด
        if cCount == 0 and sCount == 0 then
            pcall(function()
                local pg = LocalPlayer:FindFirstChild("PlayerGui")
                local csgoUi = pg and pg:FindFirstChild("CSGO_UI")
                if csgoUi then
                    for _, v in ipairs(csgoUi:GetDescendants()) do
                        if (v.Name == "Name" or v.Name == "ItemName") and v:IsA("TextLabel") then
                            local txt = tostring(v.Text or "")
                            local parent = v.Parent
                            local qtyLab = parent and (parent:FindFirstChild("Qty") or parent:FindFirstChild("QtyChip"))
                            local q = 1
                            if qtyLab and qtyLab:IsA("TextLabel") then
                                local m = string.match(tostring(qtyLab.Text or ""), "%d+")
                                if m then q = tonumber(m) or 1 end
                            end
                            if string.find(txt, "Chubby") or string.find(txt, "ชับบี้") then
                                cCount = cCount + q
                            elseif string.find(txt, "แมงมุมใยทมิฬ") or string.find(txt, "ใยทมิฬ") or string.find(txt, "Spider") then
                                sCount = sCount + q
                            end
                        end
                    end
                end
            end)
        end

        if ChubbyCountLabel then
            if cWh > 0 then
                ChubbyCountLabel.Text = string.format("1. Chubby: %d (คลัง: %d)", cCount, cWh)
            else
                ChubbyCountLabel.Text = "1. Chubby: " .. tostring(cCount)
            end
        end
        if SpiderCountLabel then
            if sWh > 0 then
                SpiderCountLabel.Text = string.format("2. แมงมุม: %d (คลัง: %d)", sCount, sWh)
            else
                SpiderCountLabel.Text = "2. แมงมุมใยทมิฬ: " .. tostring(sCount)
            end
        end
    end

    RefreshBaitBtn.MouseButton1Click:Connect(fetchBaitCounts)
    
