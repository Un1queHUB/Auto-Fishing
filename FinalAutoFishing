    -- คำนวณเส้นทางหลบหลีกสิ่งกีดขวางแบบปลอดภัย (Safe Pathfinding)
    local function computeSafePath(fromPos, toPos)
        local path = PathfindingService:CreatePath({
            AgentRadius = 1.8,
            AgentHeight = 4.8,
            AgentCanJump = true,
            WaypointSpacing = 3.5,
            Costs = {
                Water = 100,
            }
        })

        -- กรณีจุดตกปลาอยู่ริมตลิ่งหรือนอกขอบ NavMesh ให้ทดสอบจุดเยื้องเข้ามาทางผู้เล่น
        local offsets = {
            Vector3.zero,
            (fromPos - toPos).Unit * 3,
            (fromPos - toPos).Unit * 6,
            Vector3.new(2, 0, 0),
            Vector3.new(-2, 0, 0),
            Vector3.new(0, 0, 2),
            Vector3.new(0, 0, -2),
        }

        for _, off in ipairs(offsets) do
            local dest = toPos + Vector3.new(off.X, 0, off.Z)
            local ok = pcall(function()
                path:ComputeAsync(fromPos, dest)
            end)
            if ok and path.Status == Enum.PathStatus.Success then
                local wps = path:GetWaypoints()
                if #wps > 1 then
                    return path, wps
                end
            end
        end

        -- ถ้าระยะทางไกลเกิน 80 studs ให้แบ่งครึ่งทางคำนวณ
        local dist = (fromPos - toPos).Magnitude
        if dist > 80 then
            local mid = (fromPos + toPos) / 2
            local okMid = pcall(function()
                path:ComputeAsync(fromPos, mid)
            end)
            if okMid and path.Status == Enum.PathStatus.Success then
                local wps1 = path:GetWaypoints()
                local okMid2 = pcall(function()
                    path:ComputeAsync(mid, toPos)
                end)
                if okMid2 and path.Status == Enum.PathStatus.Success then
                    local wps2 = path:GetWaypoints()
                    local combined = {}
                    for _, w in ipairs(wps1) do table.insert(combined, w) end
                    for i = 2, #wps2 do table.insert(combined, wps2[i]) end
                    return path, combined
                end
            end
        end

        return nil, nil
    end

    local function walkTo(targetPos)
        if not targetPos then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not (hrp and hum) then return end

        currentWalkId = currentWalkId + 1
        local walkId = currentWalkId

        task.spawn(function()
            local function continuousMove(target, timeout)
                local startTime = os.clock()
                local stuckCount = 0
                local lastPos = hrp and hrp.Position or Vector3.zero
                local lastMoveCheck = os.clock()

                while currentWalkId == walkId and char and hum and hum.Parent and hrp and hrp.Parent do
                    if hum.WalkSpeed < 14 then
                        hum.WalkSpeed = 16
                    end
                    hum.AutoRotate = true

                    local dist2D = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(target.X, 0, target.Z)).Magnitude
                    if dist2D <= 3.5 then
                        return true
                    end

                    if (os.clock() - startTime) > (timeout or 8) then
                        return false
                    end

                    hum:MoveTo(target)

                    -- เช็คการติดสิ่งกีดขวางทุกๆ 0.25 วินาที
                    if (os.clock() - lastMoveCheck) >= 0.25 then
                        local moved = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(lastPos.X, 0, lastPos.Z)).Magnitude
                        lastPos = hrp.Position
                        lastMoveCheck = os.clock()

                        if moved < 0.45 then
                            stuckCount = stuckCount + 1
                            hum.Jump = true
                            if stuckCount >= 2 then
                                -- เดินสไลด์ออกข้าง 90 องศา (Strafe) เพื่อหลุดจากขอบประตู เสา หรือมุมตึก
                                local dir = (target - hrp.Position).Unit
                                local rightVec = Vector3.new(-dir.Z, 0, dir.X)
                                local dodgeTarget = hrp.Position + rightVec * 3.5
                                hum:MoveTo(dodgeTarget)
                                task.wait(0.3)
                                stuckCount = 0
                            end
                        else
                            stuckCount = 0
                        end
                    end

                    task.wait(0.05)
                end
                return false
            end

            local path, waypoints = computeSafePath(hrp.Position, targetPos)

            if waypoints and #waypoints > 0 then
                for i, waypoint in ipairs(waypoints) do
                    if currentWalkId ~= walkId then break end
                    if waypoint.Action == Enum.PathWaypointAction.Jump then
                        hum.Jump = true
                    end
                    continuousMove(waypoint.Position, 5)
                end
            else
                -- ถ้าไม่มีเส้นทาง Pathfinding ให้เดินตรงพร้อมระบบสไลด์หลบมุม
                continuousMove(targetPos, 45)
            end

            if currentWalkId == walkId and hum and hrp then
                hum:MoveTo(hrp.Position)
            end
        end)
    end

    local function walkToWait(targetPos, maxWaitSec)
        if not targetPos then return false end
        if Settings.UseNoclip then
            enableNoclip()
        end
        walkTo(targetPos)
        local startT = os.clock()
        local limit = maxWaitSec or 45
        local reached = false
        while (os.clock() - startT) < limit do
            task.wait(0.2)
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then break end
            local dist2D = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(targetPos.X, 0, targetPos.Z)).Magnitude
            if dist2D <= 4.5 then
                reached = true
                break
            end
            -- ปลดล็อคความเร็วตัวละครตลอดการเดินทาง
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.WalkSpeed < 14 then
                hum.WalkSpeed = 16
                hum.AutoRotate = true
            end
            LocalPlayer:SetAttribute("CSGO_Paused", false)
            LocalPlayer:SetAttribute("CSGO_UiUnlock", false)
        end
        currentWalkId = currentWalkId + 1
        if Settings.UseNoclip then
            disableNoclip()
        end
        return reached
    end

