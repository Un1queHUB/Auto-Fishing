local function markerAt(serverTime, biteAt, speed)
    local v = (serverTime - biteAt) * speed % 2
    if v < 0 then v = v + 2 end
    if v < 1 then return v end
    return 2 - v
end

local function scanInventory()
    table.clear(DetectedRods)
    table.clear(DetectedBaits)

    local activeSlot = tonumber(LocalPlayer:GetAttribute("CSGO_ActiveSlot")) or 1
    local activeCatId = tostring(LocalPlayer:GetAttribute("CSGO_CatalogId") or "")
    if activeCatId ~= "" and (string.find(activeCatId, "Rod") or string.find(activeCatId, "Fishing")) then
        table.insert(DetectedRods, {
            slot = activeSlot,
            id = activeCatId,
            name = (Config and Config.ShopItem and Config.ShopItem(activeCatId) and Config.ShopItem(activeCatId).Name) or activeCatId,
            equipped = true,
        })
    end

    pcall(function()
        if PlayerGui then
            local csgoUi = PlayerGui:FindFirstChild("CSGO_UI")
            if csgoUi then
                local hud = csgoUi:FindFirstChild("Hud")
                local slotCards = hud and hud:FindFirstChild("SlotCards")
                if slotCards then
                    for i = 1, 6 do
                        local slotFrame = slotCards:FindFirstChild("Slot" .. tostring(i))
                        if slotFrame then
                            local nameLab = slotFrame:FindFirstChild("Name")
                            local qtyLab = slotFrame:FindFirstChild("Qty")
                            local itemName = (nameLab and nameLab.Text) or ""
                            local itemQtyText = (qtyLab and qtyLab.Text) or ""
                            
                            -- สกัดเฉพาะตัวเลข
                            local qNum = 0
                            local matched = string.match(itemQtyText, "%d+")
                            if matched then 
                                qNum = tonumber(matched) or 0 
                            else
                                local lowerName = string.lower(itemName)
                                if string.find(lowerName, "rod") or string.find(lowerName, "เบ็ด") then
                                    qNum = 1
                                else
                                    qNum = 0
                                end
                            end

                            if itemName ~= "" and qNum > 0 then
                                local lowerName = string.lower(itemName)
                                if string.find(lowerName, "rod") or string.find(lowerName, "เบ็ด") then
                                    local found = false
                                    for _, r in ipairs(DetectedRods) do
                                        if r.slot == i then found = true break end
                                    end
                                    if not found then
                                        table.insert(DetectedRods, {
                                            slot = i,
                                            id = "Slot" .. tostring(i),
                                            name = itemName,
                                            qty = qNum,
                                        })
                                    end
                                elseif string.find(lowerName, "bait") or string.find(lowerName, "เหยื่อ") or string.find(lowerName, "worm") or string.find(lowerName, "chubby") then
                                    local found = false
                                    for _, b in ipairs(DetectedBaits) do
                                        if b.slot == i then found = true break end
                                    end
                                    if not found then
                                        table.insert(DetectedBaits, {
                                            slot = i,
                                            id = "Slot" .. tostring(i),
                                            name = itemName,
                                            qty = qNum,
                                        })
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end)

    -- ค้นหาเหยื่อและเบ็ดจาก Backpack ใน Profile ด้วย
    pcall(function()
        local prof = getLatestProfile()
        if prof and prof.Backpack and prof.Backpack.Slots then
            for slotIdx, slotData in pairs(prof.Backpack.Slots) do
                if typeof(slotData) == "table" and slotData.ItemId then
                    local q = tonumber(slotData.Qty) or 0
                    local id = tostring(slotData.ItemId)
                    local idLower = string.lower(id)
                    if q > 0 and (id == "BaitChubby" or id == "BaitSpider" or string.find(idLower, "bait") or string.find(idLower, "chubby") or string.find(idLower, "spider") or string.find(idLower, "เหยื่อ")) then
                        local found = false
                        for _, b in ipairs(DetectedBaits) do
                            if b.slot == slotIdx then found = true break end
                        end
                        if not found then
                            local shopItem = Config and Config.ShopItem and Config.ShopItem(id)
                            table.insert(DetectedBaits, {
                                slot = slotIdx,
                                id = id,
                                name = (shopItem and shopItem.Name) or id,
                                qty = q,
                            })
                        end
                    end
                end
            end
        end
    end)
end

local function getTargetRodSlot()
    if Settings.SelectedRodSlot ~= "auto" then
        return tonumber(Settings.SelectedRodSlot) or 1
    end
    local held = tonumber(LocalPlayer:GetAttribute("CSGO_ActiveSlot"))
    if held and held >= 1 and held <= 6 then
        for _, r in ipairs(DetectedRods) do
            if r.slot == held then return held end
        end
    end
    if #DetectedRods > 0 then
        return DetectedRods[1].slot
    end
    return 1
end

local function getTargetBaitSlot()
    scanInventory()
    local pref = string.lower(tostring(Settings.SelectedBaitSlot or "auto"))

    -- 1. ถ้าเลือกแบบระบุชนิด
    if pref == "chubby" then
        for _, b in ipairs(DetectedBaits) do
            if b.id == "BaitChubby" or string.find(string.lower(b.id), "chubby") then
                return b.slot
            end
        end
    elseif pref == "spider" then
        for _, b in ipairs(DetectedBaits) do
            if b.id == "BaitSpider" or string.find(string.lower(b.id), "spider") or string.find(b.name, "ใยทมิฬ") then
                return b.slot
            end
        end
    elseif tonumber(Settings.SelectedBaitSlot) then
        return tonumber(Settings.SelectedBaitSlot)
    end

    -- 2. ถ้ามี DetectedBaits ให้เลือกช่องแรกที่มี
    if #DetectedBaits > 0 then
        return DetectedBaits[1].slot
    end

    -- 3. ตรวจสอบตรงจาก Backpack Slots ใน Profile
    local prof = getLatestProfile()
    if prof and prof.Backpack and prof.Backpack.Slots then
        for slotIdx, slotData in pairs(prof.Backpack.Slots) do
            if typeof(slotData) == "table" and slotData.ItemId then
                local q = tonumber(slotData.Qty) or 0
                local id = tostring(slotData.ItemId)
                local idLower = string.lower(id)
                if q > 0 and (id == "BaitChubby" or id == "BaitSpider" or string.find(idLower, "bait") or string.find(idLower, "chubby") or string.find(idLower, "spider")) then
                    return tonumber(slotIdx) or slotIdx
                end
            end
        end
    end

    return 4
end

local function getCastTargetPoint()
    local cam = Workspace.CurrentCamera
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if cam then
        local camPos = cam.CFrame.Position
        local look = cam.CFrame.LookVector
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {char}
        rayParams.IgnoreWater = true
        local hit = Workspace:Raycast(camPos, look * 60, rayParams)
        if hit and (Vector3.new(hit.Position.X - camPos.X, 0, hit.Position.Z - camPos.Z)).Magnitude <= 50 then
            return hit.Position
        end
        return camPos + look * 35
    elseif hrp then
        return hrp.Position + hrp.CFrame.LookVector * 28 - Vector3.new(0, 3, 0)
    end
    return Vector3.new(0, 0, 0)
end

